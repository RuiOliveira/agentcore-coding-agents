{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteWorkshopUsageLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:*:*:log-group:/workshop/coding-agents/telemetry",
        "arn:aws:logs:*:*:log-group:/workshop/coding-agents/telemetry:*",
        "arn:aws:logs:*:*:log-group:/workshop/coding-agents/metrics",
        "arn:aws:logs:*:*:log-group:/workshop/coding-agents/metrics:*"
      ]
    },
    {
      "Sid": "InsightsMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": [
        "*"
      ]
    }
  ]
}

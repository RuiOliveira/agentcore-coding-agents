{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TradeSourceArchives",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::coding-agents-*/agents/runtime-exchange/*"
    },
    {
      "Sid": "SeeTheExchangePrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::coding-agents-*",
      "Condition": {"StringLike": {"s3:prefix": ["agents/runtime-exchange/*"]}}
    }
  ]
}
